# The environment for tests and linting. Nothing is installed on the host.
FROM python:3.13-slim

COPY --from=ghcr.io/astral-sh/uv:0.9 /uv /usr/local/bin/uv

# git is needed by the tests that build a small repository with a release tag.
RUN apt-get update && apt-get install -y --no-install-recommends git \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app
# Only pyproject.toml is copied, so this layer is cached until the dependencies change.
COPY pyproject.toml .
RUN uv pip install --system --no-cache -r pyproject.toml --group dev

# The source is mounted at run time (see the Makefile), so edits need no rebuild.
ENV PYTHONPATH=/app/src \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1
